{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Backend: FastAPI (port 8000)",
      "type": "shell",
      "command": "${workspaceFolder}/backend/.venv/bin/uvicorn app.main:app --reload --port 8000",
      "windows": {
        "command": "${workspaceFolder}\\backend\\.venv\\Scripts\\uvicorn.exe app.main:app --reload --port 8000"
      },
      "options": { "cwd": "${workspaceFolder}/backend" },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "group": "dev", "panel": "dedicated" }
    },
    {
      "label": "Frontend: Vite (port 5173)",
      "type": "shell",
      "command": "npm run dev",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "group": "dev", "panel": "dedicated" }
    },
    {
      "label": "Start HomeScope",
      "dependsOn": ["Backend: FastAPI (port 8000)", "Frontend: Vite (port 5173)"],
      "dependsOrder": "parallel",
      "problemMatcher": []
    },
    {
      "label": "Backend: tests",
      "type": "shell",
      "command": "${workspaceFolder}/backend/.venv/bin/python -m pytest -q",
      "windows": { "command": "${workspaceFolder}\\backend\\.venv\\Scripts\\python.exe -m pytest -q" },
      "options": { "cwd": "${workspaceFolder}/backend" },
      "problemMatcher": []
    }
  ]
}
