# Copy to backend/.env and adjust. All paths are relative to the repository root unless absolute.

# Where the Kaggle clean CSV and the optional listing-details extract live.
HOMESCOPE_DATA_DIR=data/raw
HOMESCOPE_CLEAN_CSV=houston_housing_2024_clean.csv
HOMESCOPE_DETAILS_CSV=houston_listing_details.csv

# If the real dataset is missing, fall back to the synthetic development fixture.
HOMESCOPE_ALLOW_FIXTURE_FALLBACK=true

# Trained model bundle (folder containing model_card.json) and batch predictions file.
HOMESCOPE_MODEL_DIR=models/current
HOMESCOPE_PREDICTIONS_PATH=models/predictions/predictions.csv

# DEVELOPMENT ONLY: generate clearly labelled "Simulated — UI Preview" valuations
# when no real model or predictions are installed. Never enable for a demo of real results.
HOMESCOPE_SIMULATED_PREDICTIONS=false

# Comma-separated origins allowed to call the API directly (the Vite proxy makes this optional in dev).
HOMESCOPE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# AI search ("Ask HomeScope"). Get a key at https://platform.openai.com/api-keys.
# Keep it in backend/.env only (git-ignored); it is never sent to the browser.
OPENAI_API_KEY=
# Model and reasoning effort for the assistant (any Responses API model with function calling).
HOMESCOPE_OPENAI_MODEL=gpt-6-luna
HOMESCOPE_OPENAI_REASONING_EFFORT=low
