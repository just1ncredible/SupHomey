# Copy to frontend/.env.local to override. All values are optional.

# Leave empty in development: the Vite dev server proxies /api to the backend.
# Set to e.g. http://localhost:8000 to call the API directly (CORS is enabled for :5173).
VITE_API_BASE_URL=

# Where the Vite proxy forwards /api requests.
VITE_API_PROXY_TARGET=http://localhost:8000

# Map tiles (any OpenStreetMap-compatible XYZ provider). Keep the attribution accurate.
# Default: standard OpenStreetMap tiles, no key needed. Fine for local development and demos;
# heavy use must follow https://operations.osmfoundation.org/policies/tiles/
VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors
# Example keyed alternative (MapTiler, Stadia, etc.) — keep keys in .env.local, never commit them:
# VITE_MAP_TILE_URL=https://api.maptiler.com/maps/dataviz/{z}/{x}/{y}.png?key=YOUR_KEY
# VITE_MAP_ATTRIBUTION=&copy; MapTiler &copy; OpenStreetMap contributors
